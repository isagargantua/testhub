<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Fast confidence check: the 'smoke' group across UI, API and the hybrid test. -->
<suite name="testHub-Smoke" parallel="classes" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.testhub.listeners.TestListener"/>
        <listener class-name="com.testhub.listeners.RetryTransformer"/>
    </listeners>

    <test name="Smoke-UI">
        <groups><run><include name="smoke"/></run></groups>
        <packages>
            <package name="com.testhub.tests.ui"/>
            <package name="com.testhub.tests.e2e"/>
        </packages>
    </test>

    <test name="Smoke-API">
        <groups><run><include name="smoke"/></run></groups>
        <packages>
            <package name="com.testhub.tests.api"/>
        </packages>
    </test>

    <!-- Only the throttle-free hybrid test carries the smoke group; the
         register-based one stays out of smoke to avoid the live 429 limit. -->
    <test name="Smoke-Hybrid">
        <groups><run><include name="smoke"/></run></groups>
        <packages>
            <package name="com.testhub.tests.hybrid"/>
        </packages>
    </test>
</suite>
