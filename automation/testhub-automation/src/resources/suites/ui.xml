<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Pure-UI tests only — every action through the browser, no API. -->
<suite name="testHub-UI" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.testhub.listeners.TestListener"/>
        <listener class-name="com.testhub.listeners.RetryTransformer"/>
    </listeners>

    <test name="UI">
        <packages>
            <package name="com.testhub.tests.ui"/>
            <package name="com.testhub.tests.e2e"/>
        </packages>
    </test>
</suite>
