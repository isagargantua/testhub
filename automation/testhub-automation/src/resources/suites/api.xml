<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Pure-API tests only — RestAssured against the gateway, no browser. -->
<suite name="testHub-API" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.testhub.listeners.TestListener"/>
        <listener class-name="com.testhub.listeners.RetryTransformer"/>
    </listeners>

    <test name="API">
        <packages>
            <package name="com.testhub.tests.api"/>
        </packages>
    </test>
</suite>
