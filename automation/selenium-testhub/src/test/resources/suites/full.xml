<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="testHub-Full" parallel="classes" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.testhub.listeners.TestListener"/>
        <listener class-name="com.testhub.listeners.RetryTransformer"/>
    </listeners>

    <test name="All-UI-and-E2E">
        <packages>
            <package name="com.testhub.tests.ui"/>
            <package name="com.testhub.tests.e2e"/>
        </packages>
    </test>

    <test name="All-API">
        <packages>
            <package name="com.testhub.tests.api"/>
        </packages>
    </test>
</suite>
