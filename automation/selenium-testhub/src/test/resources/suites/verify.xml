<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Tiny smoke suite used to validate framework wiring against a live backend
     with minimal load (single method, serial, no retry burst). -->
<suite name="testHub-Verify" verbose="2">
    <listeners>
        <listener class-name="com.testhub.listeners.TestListener"/>
    </listeners>
    <test name="Verify">
        <classes>
            <class name="com.testhub.tests.api.AuthApiTest">
                <methods>
                    <include name="registrationReturnsTokens"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>
