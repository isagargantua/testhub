<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.testhub</groupId>
    <artifactId>selenium-testhub</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>testHub Selenium Hybrid Framework</name>
    <description>
        Hybrid (Page Object Model + Data-Driven + API-assisted) UI automation
        framework for the testHub test-management platform. Selenium 4, TestNG,
        ExtentReports, RestAssured, Log4j2 — parallel-ready, CI-friendly.
    </description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions -->
        <selenium.version>4.27.0</selenium.version>
        <testng.version>7.10.2</testng.version>
        <extentreports.version>5.1.2</extentreports.version>
        <restassured.version>5.5.0</restassured.version>
        <jackson.version>2.18.2</jackson.version>
        <log4j.version>2.24.3</log4j.version>
        <commons.io.version>2.18.0</commons.io.version>
        <poi.version>5.3.0</poi.version>
        <datafaker.version>2.4.2</datafaker.version>

        <!-- Plugin versions -->
        <surefire.version>3.5.2</surefire.version>
        <compiler.plugin.version>3.13.0</compiler.plugin.version>

        <!-- Default suite — override with -DsuiteXmlFile=src/test/resources/suites/<file>.xml -->
        <suiteXmlFile>src/test/resources/suites/regression.xml</suiteXmlFile>

        <!-- Runtime defaults (override on the CLI with -Dbrowser=... -Dheadless=...) -->
        <browser>chrome</browser>
        <headless>false</headless>
    </properties>

    <dependencies>
        <!-- Selenium 4 (ships Selenium Manager: auto-resolves the browser driver) -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- ExtentReports (rich HTML reporting) -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

        <!-- RestAssured — API-assisted setup/teardown (the "hybrid" half) -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${restassured.version}</version>
        </dependency>

        <!-- Jackson — JSON test data + POJO (de)serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- Log4j2 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <!-- Route Selenium's SLF4J logging through Log4j2 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- Apache POI — Excel-driven test data -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Commons IO — file/download helpers -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons.io.version}</version>
        </dependency>

        <!-- DataFaker — realistic random test data -->
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Tells Eclipse m2e which plugin goals to ignore during the IDE build.
             This block has zero effect on "mvn test" — it is read only by Eclipse. -->
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-surefire-plugin</artifactId>
                                        <versionRange>[3.0,)</versionRange>
                                        <goals><goal>test</goal></goals>
                                    </pluginExecutionFilter>
                                    <action><ignore/></action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-compiler-plugin</artifactId>
                                        <versionRange>[3.0,)</versionRange>
                                        <goals>
                                            <goal>compile</goal>
                                            <goal>testCompile</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action><execute/></action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteXmlFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- System properties forwarded to the test JVM; override on the CLI, e.g.
                         mvn test -Dbrowser=firefox -Dheadless=true -Dbase.url=http://localhost:5173 -->
                    <systemPropertyVariables>
                        <browser>${browser}</browser>
                        <headless>${headless}</headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Psmoke -->
        <profile>
            <id>smoke</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/smoke.xml</suiteXmlFile>
            </properties>
        </profile>
        <!-- mvn test -Pregression -->
        <profile>
            <id>regression</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/regression.xml</suiteXmlFile>
            </properties>
        </profile>
        <!-- mvn test -Papi -->
        <profile>
            <id>api</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/api.xml</suiteXmlFile>
            </properties>
        </profile>
        <!-- mvn test -Pfull -->
        <profile>
            <id>full</id>
            <properties>
                <suiteXmlFile>src/test/resources/suites/full.xml</suiteXmlFile>
            </properties>
        </profile>
    </profiles>
</project>
