generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(TESTER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  TESTER
  VIEWER
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  testSuites TestSuite[]
  testRuns   TestRun[]

  // Every list/stat query filters by owner; Postgres doesn't index FKs itself.
  @@index([createdById])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model TestSuite {
  id          String  @id @default(cuid())
  name        String
  description String?
  projectId   String

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCases TestCase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([projectId])
}

model TestCase {
  id          String         @id @default(cuid())
  title       String
  description String?
  steps       String?
  expected    String?
  priority    Priority       @default(MEDIUM)
  status      TestCaseStatus @default(ACTIVE)
  tags        String[]

  suiteId     String
  suite       TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdById String

  results   TestResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([suiteId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TestCaseStatus {
  ACTIVE
  DEPRECATED
}

model TestRun {
  id              String    @id @default(cuid())
  name            String
  description     String?
  status          RunStatus @default(IN_PROGRESS)
  selectedCaseIds String[]  @default([])

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String

  results   TestResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([projectId])
}

enum RunStatus {
  IN_PROGRESS
  COMPLETED
  ABORTED
}

model TestResult {
  id      String       @id @default(cuid())
  status  ResultStatus
  comment String?

  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  runId String
  run   TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  executedAt DateTime @default(now())

  // runId lookups ride the @@unique's leading column; testCaseId needs its own.
  @@unique([runId, testCaseId])
  @@index([testCaseId])
}

enum ResultStatus {
  PASS
  FAIL
  SKIP
  BLOCKED
}

// Admin-only "data dump" vault: arbitrary uploaded artefacts (large text
// files, zipped folders, screenshots, etc.). The raw bytes live in `content`
// (Postgres bytea). This is deliberately simple/self-contained — see the
// limitations documented in core-service/src/routes/dumps.js.
model DumpItem {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  sizeBytes    Int
  kind         DumpKind @default(OTHER)
  notes        String?
  content      Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

enum DumpKind {
  TEXT
  ARCHIVE
  IMAGE
  OTHER
}
